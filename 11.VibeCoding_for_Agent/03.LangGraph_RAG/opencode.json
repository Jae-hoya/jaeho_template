{  
    "$schema": "https://opencode.ai/config.json",
      "permission": {
    "external_directory": {
      "/path/to/parent": "allow"
    }
  },
  
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true    
        },
        "docs-langchain": {
          "type": "remote",
          "url": "https://docs.langchain.com/mcp",
          "enabled": true
        },
        "playwright": {
        "type": "local",
        "command": [
            "npx",
            "@playwright/mcp@latest"
        ],
        "enabled": true
        }
    }
}


